def mount_fs(image: str, mount_dir: str):
    sh.guestmount(mount_dir, add=image, mount='/dev/sda1')

def unmount_fs(mount_dir: str):
    time.sleep(3)
    sh.fusermount(u=mount_dir)

def _run_cmd_capture(cmd, timeout=15):
    """Run command (list form) and return stdout as str (strippped). Raise on error."""
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.STDOUT, text=True, timeout=timeout)
        return out.strip()
    except subprocess.CalledProcessError as e:
        print(f"CMD FAILED: {cmd} -> returncode={e.returncode}\nOUTPUT:\n{e.output}")
        raise
    except Exception as e:
        print(f"CMD EXCEPTION: {cmd} -> {e}")
        raise

def _wait_for_path(path, timeout=5.0, poll=0.1):
    """Wait until filesystem path exists or timeout (returns True if exists)."""
    import time
    end = time.time() + timeout
    while time.time() < end:
        if os.path.exists(path):
            return True
        time.sleep(poll)
    return False


def build_disk(image, stage1, stage2, kernel, files, env):
    import os, time
    image = os.path.abspath(image)
    stage1 = os.path.abspath(stage1)
    stage2 = os.path.abspath(stage2)
    kernel = os.path.abspath(kernel)
    print("IMAGE PATH =", image)
    print("STAGE1 =", stage1)
    print("STAGE2 =", stage2)
    print("FILES =", files)

    size_sectors = (env['imageSize'] + 511) // 512
    partition_offset = 2048  # FAT32 partition start
    stage2_offset = 1        # Stage2 starts at sector 1 (just after MBR)

    # Create empty image
    generate_image_file(image, size_sectors)

    # Create partition table
    create_partition_table(image, partition_offset)

    # Setup loop device
    LOOP = _run_cmd_capture(['sudo', 'losetup', '--find', '--show', '-P', image]).strip()
    print("> LOOP DEVICE RAW:", LOOP)

    partition_dev = f"/dev/{os.path.basename(LOOP)}p1"

    # Install Stage1 to MBR (sector 0)
    print("> installing Stage1 to MBR (sector 0) ...")

    stage2_size_bytes = os.stat(stage2).st_size
    stage2_sectors = (stage2_size_bytes + 511) // 512  # round up to full sectors

    # Then call install_stage1 with all required arguments
    install_stage1(
        image, 
        stage1, 
        stage2_offset=stage2_offset, 
        stage2_size=stage2_sectors,  # <-- this was missing
        offset=0
    )


    # Install Stage2 **outside the partition**
    print(f"> installing Stage2 at disk LBA {stage2_offset} ...")
    install_stage2(image, stage2, offset=stage2_offset)

    # Format FAT32 partition (normal)
    print(f"> formatting partition {partition_dev} as FAT32 ...")
    _run_cmd_capture(['sudo', 'mkfs.fat', '-F', '32', '-n', 'NBOS', partition_dev], timeout=120)

    # Mount partition and copy kernel/files
    tmp_dir = os.path.join(os.path.dirname(image), f"tmp_mount_{int(time.time())}")
    os.makedirs(tmp_dir, exist_ok=True)
    try:
        _run_cmd_capture(['sudo', 'mount', partition_dev, tmp_dir])

        # Copy kernel
        bootdir = os.path.join(tmp_dir, 'boot')
        _run_cmd_capture(['sudo', 'mkdir', '-p', bootdir])
        _run_cmd_capture(['sudo', 'cp', kernel, bootdir])

        # Copy other files
        for file in files:
            src = file.srcnode().path
            dst = os.path.join(tmp_dir, os.path.relpath(src, env['BASEDIR']))
            _run_cmd_capture(['sudo', 'mkdir', '-p', os.path.dirname(dst)])
            _run_cmd_capture(['sudo', 'cp', '-r', src, dst])

    finally:
        _run_cmd_capture(['sudo', 'umount', tmp_dir])
        os.rmdir(tmp_dir)

    # Cleanup loop
    _run_cmd_capture(['sudo', 'losetup', '-d', LOOP])
    print("> image build complete.")


def build_image(target, source, env):
    image = str(target[0])

    if env['arch'] == 'x86_64':
        kernel = str(source[0])   # this is kernel.elf

        # build boot ISO
        build_grub_iso(target, [kernel], env)
        return
    else:
        # ---- i686 legacy path ----
        stage1 = str(source[0])
        stage2 = str(source[1])
        kernel = str(source[2])
        files = source[3:]

        if env['imageType'] == 'floppy':
            build_floppy(image, stage1, stage2, kernel, files, env)
        elif env['imageType'] == 'disk':
            build_disk(image, stage1, stage2, kernel, files, env)
        else:
            raise ValueError('Unknown image type ' + env['imageType'])


# Setup image target
root = env.Dir('root')
root_content = GlobRecursive(env, '*', root)

if env['arch'] == 'x86_64':
    inputs = [kernel]
    output_fmt = 'iso'
else:
    inputs = [stage1, stage2, kernel] + root_content
    output_fmt = 'img'

output = f'image.{output_fmt}'

image = env.Command(output, inputs,
                    action=Action(build_image, 'Creating disk image...'), 
                    BASEDIR=root.srcnode().path)
env.Depends(image, inputs)

Export('image')

if env['arch'] == 'x86_64':
    root = env.Dir('root')
    root_content = GlobRecursive(env, '*', root)

    root_img = env.Command(
        'root.img',
        root_content,
        Action(build_fat32_root_image, 'Creating FAT32 root image...'),
        BASEDIR=root.srcnode().path
    )

    env.Depends(root_img, root_content)
    Export('root_img')

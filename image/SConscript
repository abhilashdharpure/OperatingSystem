SECTOR_SIZE = 512

def generate_image_file(target: str, size_sectors: int):
    with open(target, 'wb') as fout:
        fout.write(bytes(size_sectors * SECTOR_SIZE))
        fout.close()

def create_filesystem(target: str, filesystem, reserved_sectors=0, offset=0):
    if filesystem in ['fat12', 'fat16', 'fat32']:
        reserved_sectors += 1
        if filesystem == 'fat32':
            reserved_sectors += 1

        mkfs_fat = sh.Command('mkfs.fat')
        mkfs_fat(target,
                 F=filesystem[3:],            # fat size
                 n='NBOS',                    # label
                 R=reserved_sectors,      # reserved sectors
                 offset=offset
        )
    elif filesystem == 'ext2':
        mkfs_ext2 = sh.Command('mkfs.ext2')
        mkfs_ext2(target,
                  L='NBOS',                   # label
                  E=f'offset={offset * SECTOR_SIZE}'
        )
    else:
        raise ValueError('Unsupported filesystem ' + filesystem)


def find_symbol_in_map_file(map_file: str, symbol: str):
    with map_file.open('r') as fmap:
        for line in fmap:
            if symbol in line:
                match = re.search('0x([0-9a-fA-F]+)', line)
                if match is not None:
                    return int(match.group(1), base=16)
    return None

def install_stage1(target_img: str, stage1_path: str, stage2_offset: int, stage2_size: int, offset=0):
    """
    Install stage1 into the image at sector 'offset' (usually 0 for MBR).
    Preserve the partition table (bytes 446..509) and MBR signature (510..511).
    Write stage2 LBA (stage2_offset) into the stage1 binary at the stage2_location
    spot discovered by reading the stage1 .map as before (caller already finds symbol).
    """
    # find stage1 map file and symbols (reuse your existing logic)
    map_file = Path(stage1_path).with_suffix('.map')
    if not map_file.exists():
        raise ValueError("Can't find " + str(map_file))

    entry_offset = find_symbol_in_map_file(map_file, '__entry_start')
    if entry_offset is None:
        raise ValueError("Can't find __entry_start symbol in map file " + str(map_file))
    entry_offset -= 0x7c00

    stage2_start = find_symbol_in_map_file(map_file, 'stage2_location')
    if stage2_start is None:
        raise ValueError("Can't find stage2_location symbol in map file " + str(map_file))
    stage2_start -= 0x7c00

    # Read existing MBR bytes so we can preserve partition table & signature
    with open(target_img, 'r+b') as fimage:
        # Seek to MBR (offset * 512)
        fimage.seek(offset * SECTOR_SIZE)
        mbr = fimage.read(SECTOR_SIZE)

        # Save partition table (bytes 446..509) and signature (510..511)
        part_table = mbr[446:446+64]   # four 16-byte entries (446..509)
        signature  = mbr[510:512]      # 2 bytes

        # Read the stage1 binary
        with open(stage1_path, 'rb') as fstage1:
            stage1_data = fstage1.read()

        # Now write stage1 into MBR area (but we will restore the partition table & sig)
        fimage.seek(offset * SECTOR_SIZE)
        fimage.write(stage1_data)

        # Restore partition table and signature at the right offsets
        fimage.seek(offset * SECTOR_SIZE + 446)
        fimage.write(part_table)
        fimage.seek(offset * SECTOR_SIZE + 510)
        fimage.write(signature)

        # Now write the stage2 LBA and size into the stage1 binary location
        # (stage2_start is offset inside stage1 binary area relative to 0x7c00)
        stage2_lba_bytes = int(stage2_offset).to_bytes(4, byteorder='little')
        stage2_size_byte = int(stage2_size & 0xFF).to_bytes(1, byteorder='little')

        fimage.seek(offset * SECTOR_SIZE + stage2_start)
        fimage.write(stage2_lba_bytes)
        fimage.write(stage2_size_byte)

    # done


def install_stage2(target: str, stage2: str, offset=0, limit=None):
    with open(stage2, 'rb') as fstage2:
        with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT), 'wb+') as ftarget:
            ftarget.seek(offset * SECTOR_SIZE, SEEK_SET)
            ftarget.write(fstage2.read())

def build_floppy(image, stage1, stage2, kernel, files, env):
    size_sectors = 2880
    stage2_size = os.stat(stage2).st_size
    stage2_sectors = (stage2_size + SECTOR_SIZE - 1) // SECTOR_SIZE
    
    generate_image_file(image, size_sectors)

    print(f"> formatting file using fat12...")
    create_filesystem(image, 'fat12', stage2_sectors)

    print(f"> installing stage1...")
    install_stage1(image, stage1, stage2_offset=1, stage2_size=stage2_sectors)

    print(f"> installing stage2...")
    install_stage2(image, stage2, offset=1)

    print(f"> copying files...")
    print('    ... copying', kernel)
    sh.mmd('-i', image, "::boot")
    sh.mcopy('-i', image, kernel, "::boot/")

    # copy rest of files
    src_root = env['BASEDIR']
    for file in files:
        file_src = file.srcnode().path
        file_rel = os.path.relpath(file_src, src_root)
        file_dst = '::' + file_rel

        if os.path.isdir(file_src):
            print('    ... creating directory', file_rel)
            sh.mmd('-i', image, file_dst)
        else:
            print('    ... copying', file_rel)
            sh.mcopy('-i', image, file_src, file_dst)

def create_partition_table(image, start_sector):
    size_bytes = os.path.getsize(image)
    size_sectors = size_bytes // 512

    # partition occupies entire image from start_sector to end
    cmd = f"{start_sector},{size_sectors-start_sector},0x0C,*"
    subprocess.run(
        ['sudo', 'sfdisk', image],
        input=cmd,
        text=True,
        check=True
    )

def build_grub_iso(target, source, env):
    iso = str(target[0])
    kernel = str(source[0])

    workdir = Path(env.Dir('.').abspath, 'iso_root')
    bootdir = workdir / 'boot'
    grubdir = bootdir / 'grub'
    efidir = workdir / 'EFI' / 'BOOT'

    # clean
    if workdir.exists():
        shutil.rmtree(workdir)

    # create required directories
    os.makedirs(grubdir, exist_ok=True)
    os.makedirs(efidir, exist_ok=True)
    os.makedirs(bootdir, exist_ok=True)  # make sure /boot exists
    os.makedirs(workdir / 'bin', exist_ok=True)  # make sure /bin exists

    # copy kernel
    shutil.copy2(kernel, bootdir / 'kernel.elf')

    fontdir = grubdir / 'fonts'
    os.makedirs(fontdir, exist_ok=True) 
    
    # Copy GRUB's default font
    shutil.copy2('/usr/share/grub/unicode.pf2', fontdir / 'unicode.pf2')

    # copy /bin/init from your image/root/bin/init
    # init_path = Path('image/root/bin/init')
    # if init_path.exists():
    #     shutil.copy2(init_path, workdir / 'bin/init')
    # else:
    #     raise FileNotFoundError("init binary not found at " + str(init_path))

    bin_src = Path('image/root/bin')
    bin_dst = workdir / 'bin'
    bin_dst.mkdir(parents=True, exist_ok=True)

    if not bin_src.exists():
        raise FileNotFoundError("bin directory not found at " + str(bin_src))

    for f in bin_src.iterdir():
        if f.is_file():
            shutil.copy2(f, bin_dst / f.name)


    # grub.cfg
    grub_cfg = grubdir / 'grub.cfg'
    grub_cfg.write_text(
        """set timeout=2
set default=0
#set gfxpayload=text
terminal_output console

# Enable GRUB graphics
insmod gfxterm
insmod vbe
insmod video_bochs
insmod video_cirrus

loadfont /boot/grub/fonts/unicode.pf2
terminal_output gfxterm

set gfxmode=1024x768x32
set gfxpayload=1024x768x32

menuentry "NBOS x86_64" {
    echo "Loading NBOS kernel..."
    multiboot2 /boot/kernel.elf
    boot
}
"""
    )

    # create UEFI ISO
    subprocess.check_call([
        'grub-mkrescue',
        '-o', iso,
        str(workdir),
    ])

def build_fat32_root_image(target, source, env):
    import os, shutil, subprocess
    from pathlib import Path

    root_img = str(target[0])
    root_dir = Path(env['BASEDIR'])

    print("> creating FAT32 root image:", root_img)

    # --- 1. Create empty image (adjust size here if needed) ---
    size_mb = 64  # size of disk image
    with open(root_img, 'wb') as f:
        f.truncate(size_mb * 1024 * 1024)

    # --- 2. Partition table & FAT32 partition ---
    subprocess.check_call(['sudo', 'parted', root_img, '--script', 'mklabel', 'msdos'])
    # Change start=1MiB, end=100% if you want a different layout
    subprocess.check_call(['sudo', 'parted', root_img, '--script', 'mkpart', 'primary', 'fat32', '1MiB', '100%'])
    subprocess.check_call(['sudo', 'parted', root_img, '--script', 'set', '1', 'boot', 'on'])

    # --- 3. Setup loop device ---
    loop_device = subprocess.check_output(['sudo', 'losetup', '--find', '--show', '-P', root_img], text=True).strip()
    partition_dev = f"{loop_device}p1"
    print("> loop device:", loop_device)
    print("> partition device:", partition_dev)

    try:
        # --- 4. Format FAT32 ---
        subprocess.check_call(['sudo', 'mkfs.fat', '-F', '32', '-n', 'NBOS', partition_dev])

        # --- 5. Mount partition temporarily ---
        tmp = Path(root_img).with_suffix('.mnt')
        tmp.mkdir(exist_ok=True)
        uid = os.getuid()
        gid = os.getgid()
        subprocess.check_call(['sudo', 'mount', '-o', f'uid={uid},gid={gid}', partition_dev, str(tmp)])

        # --- 6. Copy /bin/init ---
        bin_dir = tmp / 'bin'
        bin_dir.mkdir(parents=True, exist_ok=True)
        init_src = root_dir / 'bin' / 'init'
        if not init_src.exists():
            raise FileNotFoundError(f"/bin/init not found at {init_src}")
        shutil.copy2(init_src, bin_dir / 'init')
        (bin_dir / 'init').chmod(0o755)

        # --- 7. Copy other root files ---
        for f in root_dir.glob('**/*'):
            if f.is_dir():
                continue  # dirs handled by parents
            if f.is_file() and f != init_src:
                dst = tmp / f.relative_to(root_dir)
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(f, dst)

    finally:
        # --- 8. Cleanup ---
        subprocess.check_call(['sudo', 'umount', str(tmp)])
        tmp.rmdir()
        subprocess.check_call(['sudo', 'losetup', '-d', loop_device])

    print("> FAT32 root.img created successfully with partition")



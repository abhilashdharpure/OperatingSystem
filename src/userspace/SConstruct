# userspace/SConstruct

import os

TOOLCHAIN = "../../toolchain/x86_64-elf/bin"
CC = os.path.join(TOOLCHAIN, "x86_64-elf-gcc")
AS = os.path.join(TOOLCHAIN, "x86_64-elf-as")
LD = os.path.join(TOOLCHAIN, "x86_64-elf-ld")

env = Environment(
    CC=CC,
    AS=AS,
    LD=LD,
    CFLAGS=[
        "-m64",
        "-ffreestanding",
        "-nostdlib",
        "-fno-pie",
        "-fno-stack-protector",
        "-Wall",
        "-Wextra",
        "-Werror=implicit-function-declaration",
    ],
    LINKFLAGS=[
        "-nostdlib",
        "-Wl,-m,elf_x86_64",
        "-Wl,-z,max-page-size=0x1000",
        "-Wl,-Ttext=0x40000000",
        "/home/abhilash/myos-sysroot/usr/lib/crt1.o",
        "/home/abhilash/myos-sysroot/usr/lib/crti.o",
        "/home/abhilash/myos-sysroot/usr/lib/crtn.o",
    ],
)

# Correct include order
env.Append(CPPPATH=[
    "#libc/include",                         # note the leading '#'
    "/home/abhilash/myos-sysroot/usr/include",
])

env.Append(LIBPATH=[
    "/home/abhilash/myos-sysroot/usr/lib"
])

# Build libc once
libc_objs = SConscript("libc/SConscript", exports="env")

# Build programs
SConscript("bin/init/SConscript", exports=["env", "libc_objs"])
SConscript("bin/test/SConscript", exports=["env", "libc_objs"])

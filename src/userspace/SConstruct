# userspace/SConstruct

import os

TOOLCHAIN = "../../toolchain/i686-elf/bin"
CC = os.path.join(TOOLCHAIN, "i686-elf-gcc")
AS = os.path.join(TOOLCHAIN, "i686-elf-as")
LD = os.path.join(TOOLCHAIN, "i686-elf-ld")

env = Environment(
    CC=CC,
    AS=AS,
    LD=LD,
    CFLAGS="-m32 -ffreestanding -nostdlib -fno-pie -fno-stack-protector -Wall -Wextra -Ilibc/include",
    LINKFLAGS="-nostdlib -Wl,-m,elf_i386"
)

# Build libc first
SConscript("libc/SConscript", exports="env")

# Build user programs
SConscript("bin/init/SConscript", exports="env")
SConscript("bin/test/SConscript", exports="env")



import os

# --------------------------------------------------------------------
# Toolchain paths
# --------------------------------------------------------------------
WORKSPACE = os.path.expanduser(
    "~/Project/OSDev/ToolchainWorkspace"
)

PREFIX = os.path.join(WORKSPACE, "Install")
TOOLCHAIN = os.path.join(PREFIX, "bin")

CC = os.path.join(TOOLCHAIN, "x86_64-linux-musl-gcc")
AS = os.path.join(TOOLCHAIN, "x86_64-linux-musl-as")
LD = os.path.join(TOOLCHAIN, "x86_64-linux-musl-ld")

# --------------------------------------------------------------------
# Sysroot
# --------------------------------------------------------------------
SYSROOT = os.path.join(WORKSPACE, "Sysroot")

env = Environment(
    CC=CC,
    AS=AS,
    LD=LD,

    CFLAGS=[
        "-m64",
        "-ffreestanding",
        "-nostdlib",
        "-fno-pie",
        "-fno-stack-protector",
        "-Wall",
        "-Wextra",
        "-Werror=implicit-function-declaration",
        f"--sysroot={SYSROOT}",
    ],

    LINKFLAGS=[
        "-nostdlib",
        "-no-pie",
        "-static",
        "-Wl,-m,elf_x86_64",
        "-Wl,-z,max-page-size=0x1000",
        f"-Wl,-T,{os.getcwd()}/src/link.ld",

        # musl startup files (must come BEFORE libc)
        f"{SYSROOT}/usr/lib/crt1.o",
        f"{SYSROOT}/usr/lib/crti.o",
        f"{SYSROOT}/usr/lib/crtn.o",
    ],
)

# --------------------------------------------------------------------
# Include paths
# --------------------------------------------------------------------
env.Append(CPPPATH=[
    "#libc/include",
    f"{SYSROOT}/usr/include",
])

# --------------------------------------------------------------------
# Library search paths
# --------------------------------------------------------------------
env.Append(LIBPATH=[
    f"{SYSROOT}/usr/lib",
])

# --------------------------------------------------------------------
# Build libc once
# --------------------------------------------------------------------
libc_objs = SConscript("libc/SConscript", exports="env")

# --------------------------------------------------------------------
# Build programs
# --------------------------------------------------------------------
SConscript("bin/init/SConscript", exports=["env", "libc_objs"])
SConscript("bin/test/SConscript", exports=["env", "libc_objs"])
SConscript("bin/wl-test/SConscript", exports=["env", "libc_objs"])
export global Theme {
    in-out property <int> accent: 0;
    in-out property <int> wallpaper: 0;
    out property <[color]> accents: [#3b82f6, #10b981, #f59e0b, #ec4899, #8b5cf6];
    out property <[brush]> wallpapers: [
        @linear-gradient(180deg, #101a2c 0%, #2a3d5c 100%),
        @linear-gradient(180deg, #1b1b2f 0%, #5c2a4a 100%),
        @linear-gradient(180deg, #0f2a22 0%, #1f5c47 100%),
        @linear-gradient(180deg, #202020 0%, #404040 100%),
    ];
    out property <color> accent-color: accents[accent];
    out property <brush> wallpaper-brush: wallpapers[wallpaper];
}
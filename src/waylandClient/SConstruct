import os

# --- Project setup ---
project_name = 'waylandClient'
build_dir = 'build'
generated_dir = os.path.join(build_dir, 'generated')

env = Environment(
    CXX='g++',
    CC='gcc',
    CPPPATH=['.', 'src', generated_dir],
    LIBS=['wayland-client'],
    CXXFLAGS=['-std=c++17', '-Wall', '-Wextra']
)

# Ensure directories exist
env.Execute(Mkdir(build_dir))
env.Execute(Mkdir(generated_dir))

env.Append(CCFLAGS=["-Wunused-variable", "-Wno-unused-parameter", "-Wmissing-field-initializers"])

# --- Wayland protocol generation ---
# This generates a single combined C/H file per XML (all interfaces included)
protocols = [
    'protocols/xdg-shell.xml'
]

generated_sources = []
generated_headers = []

for xml in protocols:
    base = os.path.splitext(os.path.basename(xml))[0]  # "xdg-shell"
    c = os.path.join(generated_dir, f"{base}-protocol.c")
    h = os.path.join(generated_dir, f"{base}-protocol.h")
    
    env.Command(
        [c, h],
        xml,
        f'wayland-scanner private-code $SOURCE {c} && '
        f'wayland-scanner client-header $SOURCE {h}'
    )
    
    generated_sources.append(c)
    generated_headers.append(h)

# --- Source files ---
sources = [
    'src/main.cpp',
    'src/client.cpp',
] + generated_sources

# --- Build target ---
program = env.Program(
    target=os.path.join(build_dir, project_name),
    source=sources
)

# --- Run target ---
def run_compositor(target, source, env):
    display = os.environ.get('WAYLAND_DISPLAY', 'luma-0')
    print(f"[Run] Using WAYLAND_DISPLAY={display}")
    os.environ['WAYLAND_DISPLAY'] = display
    os.system(str(source[0]))

Run = env.Command('run', program, run_compositor)
# AlwaysBuild(Run)

Default('build/waylandClient')
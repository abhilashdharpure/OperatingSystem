import os

from SCons.Environment import Environment
from build_scripts.utility import GlobRecursive

Import('TARGET_ENVIRONMENT')
env = TARGET_ENVIRONMENT.Clone()

arch = env['arch']

# -------------------------------------------------------
# Common flags
# -------------------------------------------------------
env.Append(
    LINKFLAGS=[
        '-Wl,-T', env.File('linker.ld').srcnode().path,
        '-Wl,-Map=' + env.File('kernel.map').path,
        '-Wl,-z,max-page-size=0x1000',
    ],
    CPPPATH=[
        env.Dir('.').srcnode(),
        env['PROJECTDIR'].Dir('src/libs'),
    ],
)

# -------------------------------------------------------
# Collect sources
# -------------------------------------------------------
all_c_cpp = GlobRecursive(env, '*.c') + GlobRecursive(env, '*.cpp')
all_asm   = GlobRecursive(env, '*.asm')

# # --- Flatten all_asm because GlobRecursive may return nested lists ---
# flat_asm = []
# for item in all_asm:
#     if isinstance(item, list):
#         flat_asm.extend(item)
#     else:
#         flat_asm.append(item)
# all_asm = flat_asm


# -------------------------------------------------------
# Split ASM: 32-bit stub vs 64-bit kernel
# -------------------------------------------------------
asm32_sources = []
asm64_sources = []

if arch == 'x86_64':
    for src in all_asm:
        path = str(src)
        print("ASM file:", path)

        if path.endswith('arch/x86_64/boot32.asm') or \
           path.endswith('arch/x86_64/multiboot_header.asm'):
            print(" -> 32-bit ASM")
            asm32_sources.append(src)
        else:
            print(" -> 64-bit ASM")
            asm64_sources.append(src)
else:
    # i686: all ASM is 32-bit
    asm32_sources = all_asm


# asm32_sources = []
# asm64_sources = []

# if arch == 'x86_64':
#     for src in all_asm:
#         path = src.srcnode().path
#         print("ASM file:", path)

#         base = os.path.basename(path)
#         if base in ("boot32.asm", "multiboot_header.asm"):
#             print(" -> 32-bit ASM")
#             asm32_sources.append(src)
#         else:
#             print(" -> 64-bit ASM")
#             asm64_sources.append(src)
# else:
#     asm32_sources = all_asm


# -------------------------------------------------------
# Build C/C++ (64-bit for x86_64, 32-bit for i686)
# -------------------------------------------------------
if arch == 'x86_64':
    env.Append(CCFLAGS=['-m64', '-ffreestanding', '-fno-pic', '-fno-plt',
                        '-mno-red-zone', '-mcmodel=kernel'])
else:
    env.Append(CCFLAGS=['-m32', '-ffreestanding'])

c_objects = env.Object(all_c_cpp)

# -------------------------------------------------------
# Build 32-bit ASM for stub
# -------------------------------------------------------
asm32_objects = []
if asm32_sources:
    asm32 = env.Clone()
    asm32['AS'] = 'nasm'
    asm32['ASFLAGS'] = ['-f', 'elf32']
    asm32_objects = asm32.Object(asm32_sources)

# -------------------------------------------------------
# Build 64-bit ASM for kernel
# -------------------------------------------------------
asm64_objects = []
if asm64_sources:
    asm64 = env.Clone()
    asm64['AS'] = 'nasm'
    asm64['ASFLAGS'] = ['-f', 'elf64']
    asm64_objects = asm64.Object(asm64_sources)

# -------------------------------------------------------
# Link kernel with libcore
# -------------------------------------------------------
Import('libcore')

objects = []
objects += asm32_objects   # 32-bit stub first
objects += asm64_objects
objects += c_objects
objects.append(libcore)

kernel = env.Program('kernel.elf', objects)

kernel_bin = env.Command(
    'kernel.bin',
    kernel,
    'objcopy -O binary $SOURCE $TARGET'
)

kernel_stripped = env.Command(
    'kernel-stripped.elf',
    kernel,
    '$STRIP -o $TARGET $SOURCE'
)

env.Default(kernel_bin)
env.Default(kernel_stripped)

Export('kernel')
Export('kernel_bin')
Export('kernel_stripped')
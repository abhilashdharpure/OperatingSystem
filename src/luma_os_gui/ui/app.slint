import { Button, Slider, CheckBox, LineEdit } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Luma Slint";
    preferred-width: 500px;
    preferred-height: 300px;
    in-out property <int> counter: 0;

    VerticalLayout {
        padding: 16px; spacing: 12px;
        Text { text: "Hello from Slint on Luma OS"; font-size: 20px; }
        Text { text: "Clicked: \{root.counter}"; }
        Button { text: "Click me"; clicked => { root.counter += 1; } }
        Slider { minimum: 0; maximum: 100; value: root.counter; }
        CheckBox { text: "Enable something"; }
        LineEdit { placeholder-text: "type here"; }
    }
}
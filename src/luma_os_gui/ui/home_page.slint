import { Button, LineEdit } from "std-widgets.slint";
import { ToggleSwitch, PanelSlider, PanelButton } from "widgets.slint";

export struct AppState { running: int, minimized: bool, focused: bool }

export global HomeState {
    in property <string> greeting: "Welcome to Luma OS";   // C++ -> UI

    in property <[AppState]> apps;               // dock slot index = app index
    callback app-clicked(int);                   // restore, focus, or launch
    callback app-new-instance(int);              // always start another instance



    // Tray Icons
    callback lock_clicked();
    callback power_off_clicked();
    callback internet_clicked();
    callback battery_clicked();
    callback volume_clicked();

    in-out property <int> active-panel: 0;      // 0 none, 1 lock, 2 battery, 3 internet, 4 volume, 5 power

    // data pushed from C++ (kernel later)
    in property <int> battery-percent: 100;
    in property <bool> battery-charging: false;
    in property <string> wifi-name: "Not connected";
    in-out property <bool> wifi-on: true;
    in-out property <int> volume: 50;
    in-out property <bool> muted: false;



    // Menu events to C++
    callback wifi-toggled(bool);
    callback volume-changed(int);
    callback mute-toggled(bool);
    callback lock-now();
    callback restart-requested();
    callback shutdown-requested();


    in-out property <bool> settings-open: false;
    in-out property <bool> file-manager-open: false;
    in-out property <bool> terminal-open: false;
    in-out property <bool> music-open: false;


    in-out property <string> user-name;         // both ways
    callback say-hello(string);                 // UI -> C++
    callback open-settings();                   // UI -> C++
    callback open-file-manager();               // UI -> C++
    callback open-terminal();                   // UI -> C++
    callback open_music();                      // UI -> C++
}

component Spacer inherits Rectangle {
background: transparent;
}

component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <AppState> app-state;
    callback activated();
    callback new-instance();

    width: 60px;
    height: 60px;
    border-radius: 8px;
    background: ta.pressed ? #2b6aa8 :
                root.app-state.running > 0 ? (root.app-state.minimized ? #2a3340 : #1f4f80) :
                ta.has-hover ? #4a4a4a : transparent;
    animate background { duration: 120ms; }

    Image {
        source: root.icon;
        width: parent.width - 10px;
        height: parent.height - 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: fill;
        opacity: root.app-state.minimized ? 0.55 : 1.0;
    }

    // one dot per window, up to three
    HorizontalLayout {
        x: 0px;
        y: parent.height - 9px;
        width: parent.width;
        height: 6px;
        alignment: center;
        spacing: 3px;
        for n in Math.min(root.app-state.running, 3) : Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: white;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            debug("Button clicked");
            root.activated();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.new-instance();
            }
        }
    }
}

component TrayIcon inherits Rectangle {
    in property <image> icon;
    in property <AppState> app-state;
    in property <bool> selected;
    in property <length> size;

    callback activated();

    width: size;
    height: size;
    border-radius: 8px;
    background: ta.pressed ? #2b6aa8 :
                root.selected ? #3d5a80 :
                root.app-state.running > 0 ? (root.app-state.minimized ? #2a3340 : #1f4f80) :
                ta.has-hover ? #4a4a4a : transparent;
    animate background { duration: 120ms; }

    Image {
        source: root.icon;
        width: parent.width - 2px;
        height: parent.height - 2px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: fill;
        opacity: root.app-state.minimized ? 0.55 : 1.0;
    }

    // one dot per window, up to three
    HorizontalLayout {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 6px;
        alignment: center;
        spacing: 3px;
        for n in Math.min(root.app-state.running, 3) : Rectangle {
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: white;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

export component RoundedLineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;

    height: 35px;
    background: #ffffff;
    border-radius: 30px;           // This makes it perfectly round
    border-width: 1px;
    border-color: input.has-focus ? #3b82f6 : #888888; // Blue border on focus

    // Inner layout for the text field
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        // Overlay the placeholder text when empty
        if input.text == "" : Text {
            text: root.placeholder-text;
            color: #aaaaaa;
            vertical-alignment: center;
        }

        input := TextInput {
            vertical-alignment: center;
            single-line: true;
        }
    }
}



component PanelTitle inherits Text {
    color: #d7e0ea;
    font-size: 15px;
}

component LockPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 10px;
    PanelTitle { text: "Lock"; }
    Text { text: "Lock the screen and require sign-in."; color: #9fb0c0; font-size: 12px; wrap: word-wrap; }
    PanelButton {
        label: "Lock now";
        clicked => { HomeState.active-panel = 0; HomeState.lock-now(); }
    }
}

component BatteryPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 10px;
    PanelTitle { text: "Battery"; }
    Text { text: "\{HomeState.battery-percent}%"; color: white; font-size: 26px; }
    Rectangle {
        height: 10px;
        border-radius: 5px;
        background: #3b4a5a;
        Rectangle {
            width: parent.width * HomeState.battery-percent / 100;
            border-radius: 5px;
            background: HomeState.battery-percent <= 20 ? #e05252 : #4cc38a;
        }
    }
    Text {
        text: HomeState.battery-charging ? "Charging" : "On battery";
        color: #9fb0c0;
        font-size: 12px;
    }
}

component InternetPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 10px;
    PanelTitle { text: "Network"; }
    HorizontalLayout {
        Text { text: "Wi-Fi"; color: white; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        ToggleSwitch {
            checked: HomeState.wifi-on;
            toggled(v) => { HomeState.wifi-on = v; HomeState.wifi-toggled(v); }
        }
    }
    Text {
        text: HomeState.wifi-on ? HomeState.wifi-name : "Wi-Fi is off";
        color: #9fb0c0;
        font-size: 12px;
        overflow: elide;
    }
}

component VolumePanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    PanelTitle { text: "Volume"; }
    Text { text: HomeState.muted ? "Muted" : "\{HomeState.volume}%"; color: white; font-size: 22px; }
    PanelSlider {
        value: HomeState.volume;
        changed(v) => { HomeState.volume = v; HomeState.volume-changed(v); }
    }
    HorizontalLayout {
        Text { text: "Mute"; color: white; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        ToggleSwitch {
            checked: HomeState.muted;
            toggled(v) => { HomeState.muted = v; HomeState.mute-toggled(v); }
        }
    }
}

component PowerPanel inherits VerticalLayout {
    padding: 12px;
    spacing: 8px;
    PanelTitle { text: "Power"; }
    PanelButton {
        label: "Lock";
        clicked => { HomeState.active-panel = 0; HomeState.lock-now(); }
    }
    PanelButton {
        label: "Restart";
        clicked => { HomeState.active-panel = 0; HomeState.restart-requested(); }
    }
    PanelButton {
        label: "Shut down";
        base: #a33a3a;
        clicked => { HomeState.active-panel = 0; HomeState.shutdown-requested(); }
    }
}

// The one shared place. Only the content changes.
component PopupHost inherits Rectangle {
    width: 260px;
    height: HomeState.active-panel == 1 ? 120px :
            HomeState.active-panel == 2 ? 140px :
            HomeState.active-panel == 3 ? 130px :
            HomeState.active-panel == 4 ? 170px : 170px;
    background: #1f2a36;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff30;

    TouchArea { }                          // swallow clicks so they don't close the panel

    if HomeState.active-panel == 1 : LockPanel { }
    if HomeState.active-panel == 2 : BatteryPanel { }
    if HomeState.active-panel == 3 : InternetPanel { }
    if HomeState.active-panel == 4 : VolumePanel { }
    if HomeState.active-panel == 5 : PowerPanel { }
}

export component HomePage inherits Rectangle {
    background: #024f9c;

    /*
    Image {
        source: @image-url("../resources/icons/wallpaper_bicycle.jpg");
        width: parent.width;
        height: parent.height;
        image-fit: fill;
    }
    */


    VerticalLayout {
        spacing: 10px;

        // Top Bar
        Rectangle {
            width: parent.width;
            height: 30px;
            background: #0e0d0d;
            
            HorizontalLayout {
                spacing: 8px;

                Spacer { width: 250px; }

                Text { text: "24 October 2026 18:30"; color: white; font-size: 12px; }


                Spacer { width: 250px; }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 200px;
                    height: 26px;
                    border-radius: 10px;
                    background: #666765;

                    HorizontalLayout {
                        padding: 0px;
                        spacing: 8px;

                        TrayIcon {
                            size: 26px;
                            icon: @image-url("../resources/icons/lock.png");
                            activated => { HomeState.lock_clicked(); }
                        }


                        TrayIcon {
                            size: 26px;
                            icon: @image-url("../resources/icons/battery.png");
                            activated => { HomeState.battery_clicked(); }
                        }

                        TrayIcon {
                            size: 26px;
                            icon: @image-url("../resources/icons/internet.png");
                            activated => { HomeState.internet_clicked(); }
                        }


                        TrayIcon {
                            size: 26px;
                            icon: @image-url("../resources/icons/volume.png");
                            activated => { HomeState.volume_clicked(); }
                        }

                        TrayIcon {
                            size: 26px;
                            icon: @image-url("../resources/icons/power-button.png");
                            activated => { HomeState.power_off_clicked(); }
                        }
                    }
                }

                Spacer { width: 10px; }

            }
        }

        Text { text: HomeState.greeting; color: white; font-size: 20px; }

        Rectangle {
            width: parent.width;
            height: 60px;
            background: #0e0d0d;
            
            HorizontalLayout {
                padding: 5px; 
                spacing: 8px;

                RoundedLineEdit { 
                    width: 200px;
                    height: 40px;
                    text <=> HomeState.user-name; 
                }

                Spacer { width: 150px; }


                Rectangle {
                    width: 600px;
                    height: 60px;
                    border-radius: 10px;
                    background: #383636;

                    HorizontalLayout {
                        alignment: center;
                        //padding-top: 5px;
                        //padding-bottom: 5px;
                        //x: parent.width / 2 - self.width / 2;
                        //y: parent.height / 2 - self.height / 2;

                        spacing: 8px;

                        AppIcon {
                            icon: @image-url("../resources/icons/archive.png");
                            app-state: HomeState.apps[0];
                            activated => { HomeState.app-clicked(0); }
                            new-instance => { HomeState.app-new-instance(0); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/settings.png");
                            app-state: HomeState.apps[1];
                            activated => { HomeState.app-clicked(1); }
                            new-instance => { HomeState.app-new-instance(1); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/terminal.png");
                            app-state: HomeState.apps[2];
                            activated => { HomeState.app-clicked(2); }
                            new-instance => { HomeState.app-new-instance(2); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/music-player.png");
                            app-state: HomeState.apps[3];
                            activated => { HomeState.app-clicked(3); }
                            new-instance => { HomeState.app-new-instance(3); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/menu.png");
                            app-state: HomeState.apps[4];
                            activated => { HomeState.app-clicked(4); }
                            new-instance => { HomeState.app-new-instance(4); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/browser.png");
                            app-state: HomeState.apps[5];
                            activated => { HomeState.app-clicked(5); }
                            new-instance => { HomeState.app-new-instance(5); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/photos.png");
                            app-state: HomeState.apps[6];
                            activated => { HomeState.app-clicked(6); }
                            new-instance => { HomeState.app-new-instance(6); }
                        }
                        AppIcon {
                            icon: @image-url("../resources/icons/text-editor.png");
                            app-state: HomeState.apps[7];
                            activated => { HomeState.app-clicked(7); }
                            new-instance => { HomeState.app-new-instance(8); }
                        }
                    }
                }

                Spacer { width: 250px; }

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 200px;
                    height: 40px;
                    border-radius: 10px;
                    background: #b78cdd;

                    HorizontalLayout {
                        padding: 5px;
                        spacing: 8px;

                        TrayIcon {
                            icon: @image-url("../resources/icons/lock.png");
                            size: 30px;
                            selected: HomeState.active-panel == 1;
                            activated => {
                                HomeState.active-panel = HomeState.active-panel == 1 ? 0 : 1;
                                if (HomeState.active-panel == 1) { HomeState.lock_clicked(); }
                            }
                        }
                        TrayIcon {
                            icon: @image-url("../resources/icons/battery.png");
                            size: 30px;
                            selected: HomeState.active-panel == 2;
                            activated => {
                                HomeState.active-panel = HomeState.active-panel == 2 ? 0 : 2;
                                if (HomeState.active-panel == 2) { HomeState.battery_clicked(); }
                            }
                        }
                        TrayIcon {
                            icon: @image-url("../resources/icons/internet.png");
                            size: 30px;
                            selected: HomeState.active-panel == 3;
                            activated => {
                                HomeState.active-panel = HomeState.active-panel == 3 ? 0 : 3;
                                if (HomeState.active-panel == 3) { HomeState.internet_clicked(); }
                            }
                        }
                        TrayIcon {
                            icon: @image-url("../resources/icons/volume.png");
                            size: 30px;
                            selected: HomeState.active-panel == 4;
                            activated => {
                                HomeState.active-panel = HomeState.active-panel == 4 ? 0 : 4;
                                if (HomeState.active-panel == 4) { HomeState.volume_clicked(); }
                            }
                        }
                        TrayIcon {
                            icon: @image-url("../resources/icons/power-button.png");
                            size: 30px;
                            selected: HomeState.active-panel == 5;
                            activated => {
                                HomeState.active-panel = HomeState.active-panel == 5 ? 0 : 5;
                                if (HomeState.active-panel == 5) { HomeState.power_off_clicked(); }
                            }
                        }
                    }
                }
            }
        }
    }

    property <length> tray-strip: 52px;      // height of the bottom strip that holds the tray

    // click anywhere above the tray strip closes the panel
    if HomeState.active-panel != 0 : TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - root.tray-strip;
        clicked => { HomeState.active-panel = 0; }
    }

    if HomeState.active-panel != 0 : PopupHost {
        x: parent.width - self.width - 12px;
        y: parent.height - self.height - root.tray-strip - 6px;
    }
}
import { Button, LineEdit } from "std-widgets.slint";
export struct AppState { running: int, minimized: bool, focused: bool }

export global HomeState {
    in property <string> greeting: "Welcome";   // C++ -> UI
    in property <int> clicks: 0;                // C++ -> UI

    in property <[AppState]> apps;               // dock slot index = app index
    callback app-clicked(int);                   // restore, focus, or launch
    callback app-new-instance(int);              // always start another instance


    in-out property <bool> settings-open: false;
    in-out property <bool> file-manager-open: false;
    in-out property <bool> terminal-open: false;
    in-out property <bool> music-open: false;


    in-out property <string> user-name;         // both ways
    callback say-hello(string);                 // UI -> C++
    callback open-settings();                   // UI -> C++
    callback open-file-manager();               // UI -> C++
    callback open-terminal();                   // UI -> C++
    callback open_music();                      // UI -> C++
}
component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <AppState> app-state;
    callback activated();
    callback new-instance();

    width: 60px;
    height: 60px;
    border-radius: 8px;
    background: ta.pressed ? #2b6aa8 :
                root.app-state.running > 0 ? (root.app-state.minimized ? #2a3340 : #1f4f80) :
                ta.has-hover ? #4a4a4a : transparent;
    animate background { duration: 120ms; }

    Image {
        source: root.icon;
        width: parent.width - 10px;
        height: parent.height - 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: fill;
        opacity: root.app-state.minimized ? 0.55 : 1.0;
    }

    // one dot per window, up to three
    HorizontalLayout {
        x: 0px;
        y: parent.height - 9px;
        width: parent.width;
        height: 6px;
        alignment: center;
        spacing: 3px;
        for n in Math.min(root.app-state.running, 3) : Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: white;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            debug("Button clicked");
            root.activated();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.new-instance();
            }
        }
    }
}

export component RoundedLineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;

    height: 35px;
    background: #ffffff;
    border-radius: 30px;           // This makes it perfectly round
    border-width: 1px;
    border-color: input.has-focus ? #3b82f6 : #888888; // Blue border on focus

    // Inner layout for the text field
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        // Overlay the placeholder text when empty
        if input.text == "" : Text {
            text: root.placeholder-text;
            color: #aaaaaa;
            vertical-alignment: center;
        }

        input := TextInput {
            vertical-alignment: center;
            single-line: true;
        }
    }
}

export component HomePage inherits Rectangle {
    background: #024f9c;

    /*
    Image {
        source: @image-url("../resources/icons/wallpaper_bicycle.jpg");
        width: parent.width;
        height: parent.height;
        image-fit: fill;
    }
    */


    VerticalLayout {
        padding: 16px; spacing: 10px;
        Text { text: HomeState.greeting; color: white; font-size: 20px; }
        Text { text: "Clicks: \{HomeState.clicks}"; color: white; }
        //Button { text: "Say hello"; clicked => { HomeState.say-hello(HomeState.user-name); } }
        //Button { text: "Settings"; clicked => { HomeState.open-settings(); } }

        HorizontalLayout {
            spacing: 8px;

            RoundedLineEdit { 
                width: 200px;
                height: 50px;
                text <=> HomeState.user-name; 
            }

            Rectangle {
                width: 400px;
                height: 60px;
                border-radius: 10px;
                background: #3a2950;

                HorizontalLayout {
                    alignment: center;
                    //padding-top: 5px;
                    //padding-bottom: 5px;
                    //x: parent.width / 2 - self.width / 2;
                    //y: parent.height / 2 - self.height / 2;

                    spacing: 8px;

                    AppIcon {
                        icon: @image-url("../resources/icons/archive.png");
                        app-state: HomeState.apps[0];
                        activated => { HomeState.app-clicked(0); }
                        new-instance => { HomeState.app-new-instance(0); }
                    }
                    AppIcon {
                        icon: @image-url("../resources/icons/settings.png");
                        app-state: HomeState.apps[1];
                        activated => { HomeState.app-clicked(1); }
                        new-instance => { HomeState.app-new-instance(1); }
                    }
                    AppIcon {
                        icon: @image-url("../resources/icons/terminals.png");
                        app-state: HomeState.apps[2];
                        activated => { HomeState.app-clicked(2); }
                        new-instance => { HomeState.app-new-instance(2); }
                    }
                    AppIcon {
                        icon: @image-url("../resources/icons/music-player.png");
                        app-state: HomeState.apps[3];
                        activated => { HomeState.app-clicked(3); }
                        new-instance => { HomeState.app-new-instance(3); }
                    }
                }
            }
        }
    }
}
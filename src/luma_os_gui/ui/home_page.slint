import { Button, LineEdit } from "std-widgets.slint";

export global HomeState {
    in property <string> greeting: "Welcome";   // C++ -> UI
    in property <int> clicks: 0;                // C++ -> UI
    in-out property <string> user-name;         // both ways
    callback say-hello(string);                 // UI -> C++
    callback open-settings();                   // UI -> C++
    callback open-file-manager();               // UI -> C++
}

export component HomePage inherits Rectangle {
    background: #024f9c;

    VerticalLayout {
        padding: 16px; spacing: 10px;
        Text { text: HomeState.greeting; color: white; font-size: 20px; }
        Text { text: "Clicks: \{HomeState.clicks}"; color: white; }
        //Button { text: "Say hello"; clicked => { HomeState.say-hello(HomeState.user-name); } }
        //Button { text: "Settings"; clicked => { HomeState.open-settings(); } }


        Rectangle {
            height: 80px;
            background: #fffafa;

            HorizontalLayout {
                spacing: 8px;

                LineEdit { 
                    width: 300px;
                    height: 50px;
                    text <=> HomeState.user-name; 
                }


                Rectangle {
                    width: 64px;
                    height: 64px;

                    Image {
                        source: @image-url("../resources/icons/archive.png");
                        width: 64px;
                        height: 64px;
                        image-fit: fill;
                    }
                    TouchArea {
                        clicked => {
                            debug("File Manager clicked!");
                            HomeState.open-file-manager();
                        }
                   }
                }

                Rectangle {
                    width: 64px;
                    height: 64px;

                    Image {
                        source: @image-url("../resources/icons/settings.png");
                        width: parent.width;
                        height: parent.height;
                        image-fit: fill;
                    }
                    TouchArea {
                        clicked => {
                            debug("Image clicked!");
                            HomeState.open-settings();
                        }

                   }
                }


                Image {
                    source: @image-url("../resources/icons/terminals.png");
                    width: 64px;
                    height: 64px;
                    image-fit: fill;
                }

                Image {
                    source: @image-url("../resources/icons/music-player.png");
                    width: 64px;
                    height: 64px;
                    image-fit: fill;
                }
            }
        }
    }
}
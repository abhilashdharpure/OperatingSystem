import { FileManagerPage, FileManagerState } from "file_manager.slint";
import { TitleBar, WindowControl } from "title_bar.slint";
import { FileEntry, Place } from "types.slint";

export { FileManagerState, WindowControl, FileEntry, Place }

export component AppWindow inherits Window {
    default-font-family: "DejaVu Sans";
    title: "File Manager";
    preferred-width: 900px;
    preferred-height: 500px;
    background: #121921;

    Rectangle {
        width: parent.width;
        height: parent.height;
         
        VerticalLayout {
            width: parent.width;
            height: parent.height;
             
            TitleBar { title: "File Manager"; }
            FileManagerPage { vertical-stretch: 1; }
        }
    }
}